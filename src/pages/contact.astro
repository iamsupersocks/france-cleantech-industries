---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { siteConfig } from "../lib/site";

const page = await getEntry("pages", "contact");
if (!page) {
  throw new Error("Missing contact content");
}
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description} path="/contact/">
  <div class="shell">
    <header class="page-head">
      <p class="hero-kicker">Écrire</p>
      <h1>{page.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
    <div class="contact-rail">
      {
        siteConfig.contacts.map((contact) => (
          <a class="contact-card" href={contact.href}>
            <span>{contact.label}</span>
            <strong>{contact.value}</strong>
          </a>
        ))
      }
    </div>
    <p class="note">{siteConfig.newsletterNote}</p>
  </div>
</Base>
